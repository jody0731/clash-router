#!/bin/sh /etc/rc.common
# Stall watcher for Nikki's Clash: see /usr/share/stall-watcher/stall-watcher.uc. Logs: logread -e stall-watcher
START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/share/stall-watcher/stall-watcher.uc
	procd_set_param nice 10
	procd_set_param respawn 3600 10 5
	procd_set_param stderr 1
	procd_close_instance
}
